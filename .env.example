PORT=3000
NODE_ENV=development

DATABASE_URL=postgres://outreach:***@db:5432/outreach
DB_PASSWORD=changeme

# ── Branding del servizio (Outreach Service di default, personalizzabile) ──
OUTR_APP_NAME=Outreach Service
OUTR_DEFAULT_FROM_NAME=Outreach Service
OUTR_SUPPORT_EMAIL=
OUTR_SUPPORT_URL=
OUTR_REFERER_URL=
OUTR_OPENROUTER_TITLE=Outreach Service
OUTR_FOOTER_COMPANY=
OUTR_FOOTER_VAT=
OUTR_FOOTER_ADDRESS=
OUTR_FOOTER_PHONE=
# Email utente protetta (non eliminabile dall'admin) — lascia vuoto se non serve
PROTECTED_USER_EMAIL=

JWT_SECRET=genera_un_secret_casuale_con_64_byte_hex
JWT_EXPIRES_IN=24h
TRUST_PROXY=false
MAGIC_LINK_EXPIRY_MS=900000

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_EXTRACTION=google/gemini-2.0-flash-lite-preview
OPENROUTER_MODEL_COPYWRITER=openai/gpt-4o-mini
OPENROUTER_MODEL_VALIDATOR=google/gemini-2.0-flash-lite-preview
SERPER_API_KEY=...
GROQ_API_KEY=...

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=...
SMTP_PASS=...
EMAIL_FROM=noreply@example.com
MAGIC_LINK_BASE_URL=http://localhost:3000

LOG_LEVEL=debug

# Browser headless (Chromium) per scraping JS sites
# BROWSER_ENABLED=true
# BROWSER_MAX_PAGES=4
# BROWSER_TIMEOUT_MS=25000

OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=465
OUTREACH_SMTP_USER=
OUTREACH_SMTP_PASS=
OUTREACH_EMAIL_FROM=

# Integrazione CMS (sostituisce la vecchia integrazione legacy). Servizio mono-tenant: un'istanza = un sito CMS.
# CMS_AGENT_TOKEN: genera un token statico "agtok_..." da /admin/api-tokens sul CMS,
# scoped all'utente/sito che vuoi collegare. Nessun flusso OTP necessario per un servizio esterno.
CMS_BASE_URL=https://cms.example.com
CMS_AGENT_TOKEN=agtok_...
CMS_SITE_ID=1
# Mappa opzionale funnel -> pipeline_id di fallback (usata solo se una campagna non ha un
# cms_pipeline_id esplicito impostato da /admin/cms). Formato JSON.
CMS_PIPELINE_MAP={}
