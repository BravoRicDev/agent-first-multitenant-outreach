// Calcola giorni lavorativi e data finale per la preview (stessa logica del backend)
function businessDaysCount(startISO, n, perDay) {
  const offset = Math.max(0, Math.ceil(n / perDay) - 1);
  let dt = new Date(startISO + 'T12:00:00Z');
  let added = 0;
  while (added < offset) {
    dt.setUTCDate(dt.getUTCDate() + 1);
    const dow = dt.getUTCDay();
    if (dow !== 0 && dow !== 6) added++;
  }
  return { days: offset + 1, end: dt.toISOString().slice(0, 10) };
}

function updateSpreadPreview() {
  const start = document.getElementById('spreadStartDate').value;
  const perDay = parseInt(document.getElementById('spreadPerDay').value, 10) || 0;
  const n = (window._batchScheduleIds || []).length;
  const el = document.getElementById('spreadPreview');
  if (!start || perDay < 1 || n === 0) {
    el.textContent = 'Seleziona data di partenza, email al giorno e almeno un azienda.';
    return;
  }
  const { days, end } = businessDaysCount(start, n, perDay);
  const fmt = (s) => { const [yy, mm, dd] = s.split('-'); return `${dd}/${mm}/${yy}`; };
  el.textContent = `📊 ${n} email → ${perDay} al giorno → ${days} giorni lavorativi (dal ${fmt(start)} al ${fmt(end)})`;
}

async function saveScheduleSpread() {
  const ids = window._batchScheduleIds;
  if (!ids || ids.length === 0) { showToast('❌ Seleziona almeno un azienda', 'error'); return; }
  const start = document.getElementById('spreadStartDate').value;
  const hour = document.getElementById('spreadHour').value;
  const perDay = parseInt(document.getElementById('spreadPerDay').value, 10);
  if (!start) { showToast('❌ Scegli la data di partenza', 'error'); return; }
  if (!perDay || perDay < 1) { showToast('❌ Indica quante email al giorno (min 1)', 'error'); return; }
  try {
    const res = await fetch(`/api/campaigns/${CAMPAIGN_ID}/companies/batch-schedule-spread`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ company_ids: ids, start_date: start, hour: parseInt(hour, 10), per_day: perDay })
    });
    const data = await res.json();
    if (!res.ok || !data.success) {
      showToast('❌ ' + (data.error || 'Errore programmazione'), 'error');
      return;
    }
    const s = data.spread;
    const fmt = (x) => { const [yy, mm, dd] = x.split('-'); return `${dd}/${mm}/${yy}`; };
    let msg = `✅ ${data.updated} aziende programmati: ${s.per_day}/giorno dal ${fmt(s.start_date)} al ${fmt(s.end_date)} (${s.business_days} giorni lavorativi)`;
    if (data.skipped_cold > 0) msg += `. ❄️ ${data.skipped_cold} saltati (consenso cold: richiedono invio manuale one-to-one)`;
    showToast(msg, data.skipped_cold > 0 ? 'warning' : 'success');
    closeModal('scheduleModal');
    window._batchScheduleIds = null;
    document.getElementById('selectAllCompanies').checked = false;
    await loadCompanies();
  } catch (e) { showToast('❌ Errore di rete: ' + e.message, 'error'); }
}

async function clearSchedule() {
  if (!confirm('Rimuovere la data di programmazione?')) return;
  try {
    const res = await fetch(`/api/campaigns/${CAMPAIGN_ID}/companies/${scheduleTargetId}/schedule`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ scheduled_at: null })
    });
    const data = await res.json();
    if (!res.ok || !data.success) { showToast('❌ ' + (data.error || 'Errore rimozione programmazione'), 'error'); return; }
    showToast('✅ Programmazione rimossa', 'success');
    closeModal('scheduleModal');
    await loadCompanies();
  } catch (e) { showToast('Errore di rete', 'error'); }
}

async function openBatchSchedule() {
  const ids = getSelectedIds();
  if (ids.length === 0) { showToast('❌ Seleziona almeno un azienda', 'error'); return; }
  window._batchScheduleIds = ids;
  document.getElementById('scheduleTitle').textContent = `Pianifica invio per ${ids.length} aziende`;
  document.getElementById('scheduleDesc').textContent = 'Scegli: stessa data per tutti, oppure spalma sul mese con un numero di email al giorno';
  // Modalità batch: mostra il toggle e riparte da "stessa data"
  document.getElementById('scheduleModeToggle').style.display = 'flex';
  setScheduleMode('single');
  const picker = document.getElementById('scheduleDatePicker');
  picker.value = '';
  document.getElementById('spreadStartDate').value = '';
  document.getElementById('spreadPerDay').value = '10';
  document.getElementById('scheduleModal').style.display = 'flex';
}

async function saveSchedule() {
  if (scheduleMode === 'spread') {
    return saveScheduleSpread();
  }
  const picker = document.getElementById('scheduleDatePicker');
  const dateVal = picker.value;
  if (!dateVal) { showToast('Seleziona una data', 'error'); return; }
  
  const batchIds = window._batchScheduleIds;
  try {
    if (batchIds && batchIds.length >= 1) {
      const res = await fetch(`/api/campaigns/${CAMPAIGN_ID}/companies/batch-schedule`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ company_ids: batchIds, scheduled_at: new Date(dateVal).toISOString() })
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        showToast('❌ ' + (data.error || 'Errore programmazione'), 'error');
        return;
      }
      let msg = `✅ ${data.updated} aziende programmati per ${new Date(data.scheduled_at).toLocaleDateString('it-IT')}`;
      if (data.skipped_cold > 0) msg += `. ❄️ ${data.skipped_cold} saltati (consenso cold: richiedono invio manuale one-to-one)`;
      showToast(msg, data.skipped_cold > 0 ? 'warning' : 'success');
      closeModal('scheduleModal');
      window._batchScheduleIds = null;
      document.getElementById('selectAllCompanies').checked = false;
    } else {
      // Single company from inline button — use scheduleTargetId
      if (!scheduleTargetId) { showToast('❌ Nessun azienda selezionato', 'error'); return; }
      const res = await fetch(`/api/campaigns/${CAMPAIGN_ID}/companies/${scheduleTargetId}/schedule`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ scheduled_at: new Date(dateVal).toISOString() })
      });
      const data = await res.json();
      if (!res.ok || !data.success) { showToast('❌ ' + (data.error || 'Errore programmazione'), 'error'); return; }
      showToast('✅ Data programmazione salvata!', 'success');
      closeModal('scheduleModal');
    }
    await loadCompanies();
  } catch (e) { showToast('❌ Errore di rete: ' + e.message, 'error'); }
}

// ── Edit email ──
let editEmailTargetId = null;

function openEditEmail(companyId) {
  editEmailTargetId = companyId;
  const d = companies.find(x => x.id === companyId);
  if (!d) return;
  document.getElementById('editEmailCompanyName').textContent = [d.nome_studio, d.nome_azienda].filter(Boolean).join(' - ') || 'Azienda';
  document.getElementById('editEmailInput').value = d.email || '';
  document.getElementById('editEmailFeedback').style.display = 'none';
  document.getElementById('editEmailModal').style.display = 'flex';
  setTimeout(() => document.getElementById('editEmailInput').focus(), 100);
}

document.getElementById('btnSaveEditEmail').addEventListener('click', async () => {
  const companyId = editEmailTargetId;
  const newEmail = document.getElementById('editEmailInput').value.trim();
  const feedback = document.getElementById('editEmailFeedback');
  if (!newEmail || !newEmail.includes('@')) {
    feedback.style.display = 'block';
    feedback.style.color = '#ef4444';
    feedback.textContent = '❌ Inserisci un indirizzo email valido';
    return;
  }
  try {
    const res = await fetch(`/api/companies/${companyId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: newEmail })
    });
    const data = await res.json();
    if (data.success || data.id) {
      showToast('✅ Email aggiornata! Rigenera la bozza con "Rig."', 'success');
      closeModal('editEmailModal');
      await loadCompanies();
    } else {
      feedback.style.display = 'block';
      feedback.style.color = '#ef4444';
      feedback.textContent = '❌ ' + (data.error || 'Errore sconosciuto');
    }
  } catch (e) {
    feedback.style.display = 'block';
    feedback.style.color = '#ef4444';
    feedback.textContent = '❌ Errore di rete';
  }
});

document.getElementById('btnCancelEditEmail').addEventListener('click', () => closeModal('editEmailModal'));
document.getElementById('btnCloseEditEmail').addEventListener('click', () => closeModal('editEmailModal'));
// Enter key saves
document.getElementById('editEmailInput').addEventListener('keydown', (e) => {
  if (e.key === 'Enter') document.getElementById('btnSaveEditEmail').click();
});

// ── Modal close helper ──
function closeModal(id) { document.getElementById(id).style.display = 'none'; }
document.addEventListener('click', function(e) {
