<div class="page-header">
  <h1><%= campaign.name %> — Workflow</h1>
  <div style="display:flex;gap:8px;align-items:center;">
    <a href="/campaigns" class="btn btn-secondary">← Tutte le campagne</a>
    <a href="/campaigns/<%= campaign.id %>" class="btn btn-secondary">✏️ Modifica campagna</a>
  </div>
</div>

<!-- Istruzioni a prova di scimmia -->
<details class="help-panel" style="margin-bottom:16px;border:1px solid var(--border);border-radius:10px;background:var(--hover-bg);">
  <summary style="cursor:pointer;padding:12px 16px;font-weight:600;font-size:14px;color:var(--brand-primary);">❓ Come funziona — la guida in 3 passi</summary>
  <div style="padding:4px 16px 14px;font-size:13px;line-height:1.7;color:var(--text-primary);">
    <p style="margin:8px 0;"><strong>📅 Pianificare gli invii in blocco (il modo più veloce):</strong></p>
    <ol style="margin:4px 0 10px 20px;padding:0;">
      <li>Nel filtro scegli <strong>"Approvati"</strong> — qui vedi solo le email pronte che mancano ancora di data d'invio.</li>
      <li>Scegli <strong>"Seleziona N"</strong> (es. 20): seleziona da solo i primi 20 studi pianificabili, saltando chi è già programmato o bloccato.</li>
      <li>Clicca <strong>"📅 Pian."</strong> → scegli <strong>"📅 Stessa data"</strong> o <strong>"⏳ Spalma sul mese"</strong>.</li>
      <li><strong>⏳ Spalma sul mese:</strong> scegli data di partenza, ora e quante email al giorno (es. 10) → <strong>"Salva"</strong>. Il sistema distribuisce da solo le email sui giorni lavorativi (lun-ven, 8:00-17:00). Esempio: 100 email a 10/giorno = 10 giorni lavorativi.</li>
      <li>✅ Fatto: i aziende spariscono dalla lista e compaiono nel filtro <strong>"📅 Pianificati"</strong> con la loro data. Ripeti finché non finisci!</li>
    </ol>
    <p style="margin:8px 0;"><strong>✅ Approvare una bozza:</strong> clicca <strong>"○ Approva"</strong> sulla riga (diventa verde "✓ Approvato"). Per tante insieme: spunta le caselle e clicca <strong>"✓ Appr."</strong> in alto.</p>
    <p style="margin:8px 0;"><strong>🔄 Rigenerare una bozza:</strong> clicca <strong>"🔄"</strong> sulla riga — l'AI ne crea una nuova (aspetta qualche secondo, la lista si aggiorna da sola).</p>
    <p style="margin:8px 0;"><strong>🕐 Le email partono da sole</strong> tra le 8:00 e le 17:00 nei giorni feriali. Chi è in "📅 Pianificati" è già in coda: non serve fare niente.</p>
  </div>
</details>

<!-- KPI Stats -->
<div class="kpi-grid" style="grid-template-columns:repeat(auto-fill,minmax(130px,1fr));margin-bottom:16px;" id="workflowKpis">
  <div class="kpi-card"><div class="kpi-value" id="kpiTotal">—</div><div class="kpi-label">Totale aziende</div></div>
  <div class="kpi-card"><div class="kpi-value" id="kpiDraft">—</div><div class="kpi-label">Bozze create</div></div>
  <div class="kpi-card"><div class="kpi-value" id="kpiApproved">—</div><div class="kpi-label">Approvati</div></div>
  <div class="kpi-card"><div class="kpi-value" id="kpiScheduled">—</div><div class="kpi-label">📅 Pianificati</div></div>
  <div class="kpi-card"><div class="kpi-value" id="kpiSent">—</div><div class="kpi-label">Inviati</div></div>
  <div class="kpi-card"><div class="kpi-value" id="kpiOpened">—</div><div class="kpi-label">Aperti</div></div>
  <div class="kpi-card"><div class="kpi-value" id="kpiBounced">—</div><div class="kpi-label">Bounced</div></div>
  <div class="kpi-card"><div class="kpi-value" id="kpiFailed" style="font-size:22px;">—</div><div class="kpi-label">❌ Falliti</div></div>
</div>

<!-- Diagnostic Alerts -->
<div id="diagnosticAlerts" style="margin-bottom:12px;"></div>

<!-- Action Bar -->
<div class="card" style="padding:12px 16px;margin-bottom:16px;">
  <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
    <button class="btn btn-primary" id="btnOpenAddCompanies">➕ Aggiungi aziende</button>
    <button class="btn btn-secondary" id="btnGenerateAllDrafts">🔄 Genera bozze</button>
    <button class="btn btn-danger" id="btnRemoveNoEmail" style="display:none;padding:6px 14px;font-size:12px;background:#ef4444;color:#fff;border:none;border-radius:6px;cursor:pointer;">🗑️ Rimuovi tutti i senza email</button>
    <a href="/api/campaigns/<%= campaign.id %>/companies/export-csv" class="btn btn-secondary" style="text-decoration:none;display:inline-flex;align-items:center;gap:4px;padding:6px 14px;">⬇ CSV</a>
    <span style="display:flex;gap:3px;padding:0 4px;border-left:2px solid var(--border);margin-left:4px;flex-wrap:wrap;">
      <button class="btn btn-sm btn-success" id="btnBatchApprove" disabled style="padding:3px 7px;font-size:11px;background:#10b981;color:#fff;">✓ Appr.</button>
      <button class="btn btn-sm btn-secondary" id="btnBatchRegen" disabled style="padding:3px 7px;font-size:11px;">🔄 Rig.</button>
      <button class="btn btn-sm btn-secondary" id="btnBatchSchedule" disabled style="padding:3px 7px;font-size:11px;">📅 Pian.</button>
      <button class="btn btn-sm btn-secondary" id="btnBatchFollowupGenerate" disabled style="padding:3px 7px;font-size:11px;">🤖 Gen.FU</button>
      <button class="btn btn-sm btn-success" id="btnBatchFollowupApprove" disabled style="padding:3px 7px;font-size:11px;background:#8b5cf6;color:#fff;">✅ Appr.FU</button>
      <button class="btn btn-sm btn-danger" id="btnBatchRemove" disabled style="padding:3px 7px;font-size:11px;background:#ef4444;color:#fff;">✕ Rim.</button>
    </span>
    <span style="display:flex;gap:3px;align-items:center;padding:0 4px;border-left:2px solid var(--border);margin-left:4px;">
      <select id="selectN" title="Seleziona automaticamente i primi N aziende pianificabili (salta chi è già pianificato, consenso cold o bloccato)" style="padding:3px 7px;font-size:11px;border:1px solid var(--border);border-radius:6px;cursor:pointer;background:#fff;">
        <option value="0">Seleziona N</option>
        <option value="10">10</option>
        <option value="20">20</option>
        <option value="30">30</option>
        <option value="50">50</option>
        <option value="100">100</option>
      </select>
    </span>
    <span style="flex:1;"></span>
    <select id="workflowFilter" style="width:auto;padding:6px 10px;border:1px solid var(--border);border-radius:6px;font-size:13px;">
      <option value="all">Tutti</option>
      <option value="pending">Senza bozza</option>
      <option value="draft">Bozza pronta</option>
      <option value="approved">Approvati</option>
      <option value="scheduled">📅 Pianificati</option>
      <option value="sent">Inviati</option>
      <option value="bounced">Bounced</option>
      <option value="opened">Aperti</option>
      <option value="failed">❌ Falliti</option>
      <option value="noemail">📭 Senza email</option>
    </select>
    <input type="search" id="workflowSearch" placeholder="Cerca azienda..." style="width:150px;padding:6px 10px;border:1px solid var(--border);border-radius:6px;font-size:13px;">
    <button class="btn btn-sm btn-secondary" id="btnSearchCompanies" style="padding:4px 10px;font-size:12px;">🔍</button>
    <button class="btn btn-sm btn-secondary" id="btnResetFilters" style="padding:4px 10px;font-size:12px;">↺ Reset</button>
  </div>
</div>

<!-- Company Table -->
<div class="card" style="overflow-x:auto;">
  <table id="workflowTable" style="table-layout:fixed;width:100%;">
    <thead>
      <tr>
        <th style="width:30px;"><input type="checkbox" id="selectAllCompanies"></th>
        <th style="width:30px;"></th>
        <th class="sortable" data-sort="nome_studio">Studio / Azienda <span class="sort-icon"></span></th>
        <th style="width:220px;" class="sortable" data-sort="email">Email <span class="sort-icon"></span></th>
        <th style="width:80px;" class="sortable" data-sort="comune">Città <span class="sort-icon"></span></th>
        <th style="width:95px;" class="sortable" data-sort="bozza_creata">Stato <span class="sort-icon"></span></th>
        <th style="width:140px;">Oggetto email</th>
        <th style="width:85px;" class="sortable" data-sort="followup_sent">Followup <span class="sort-icon"></span></th>
        <th style="width:95px;" class="sortable" data-sort="send_scheduled_at">Pianificato <span class="sort-icon"></span></th>
        <th style="width:130px;">Azioni</th>
      </tr>
    </thead>
    <tbody id="workflowTbody">
      <tr><td colspan="10" style="text-align:center;padding:40px;color:var(--text-secondary);">Caricamento in corso...</td></tr>
    </tbody>
  </table>
  <!-- Infinite scroll sentinel -->
  <div id="scrollSentinel" style="height:1px;"></div>
  <div style="text-align:center;padding:8px;font-size:12px;color:var(--text-secondary);">
    <span id="totalCompaniesCount"></span>
  </div>
</div>

<!-- Add Companies Modal -->
<div id="addCompaniesModal" class="modal-overlay" style="display:none;">
  <div class="modal" style="max-width:900px;">
    <div class="modal-header">
      <h3>Aggiungi aziende alla campagna</h3>
      <button class="modal-close" id="btnModalCloseAddCompanies">&times;</button>
    </div>
    <div class="modal-body">
      <div style="display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap;">
        <input type="search" id="addCompanySearch" placeholder="Cerca... " style="flex:1;min-width:140px;padding:8px 12px;border:1px solid var(--border);border-radius:6px;font-size:14px;">
        <select id="addCompanyRegione" style="width:150px;padding:8px 12px;border:1px solid var(--border);border-radius:6px;font-size:14px;">
          <option value="">Tutte le regioni</option>
        </select>
        <select id="addCompanyProvincia" style="width:120px;padding:8px 12px;border:1px solid var(--border);border-radius:6px;font-size:14px;">
          <option value="">Tutte le province</option>
        </select>
      </div>
      <div style="max-height:400px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;">
        <table style="width:100%;font-size:13px;">
          <thead>
            <tr>
              <th style="width:32px;"><input type="checkbox" id="selectAllAvailable"></th>
              <th>Studio</th>
              <th>Email</th>
              <th>Città</th>
              <th>Prov.</th>
            </tr>
          </thead>
          <tbody id="availableCompaniesTbody">
            <tr><td colspan="5" style="text-align:center;padding:20px;color:var(--text-secondary);">Caricamento...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="modal-footer" style="display:flex;justify-content:space-between;align-items:center;">
      <span id="selectedCount" style="font-size:13px;color:var(--text-secondary);">Nessun azienda selezionato</span>
      <div style="display:flex;gap:8px;">
        <button class="btn btn-secondary" id="btnCancelAddCompanies">Annulla</button>
        <button class="btn btn-primary" id="btnAddSelectedCompanies">➕ Aggiungi selezionati</button>
      </div>
    </div>
  </div>
</div>

<!-- Draft Preview Modal -->
<div id="previewModal" class="modal-overlay" style="display:none;">
  <div class="modal" style="max-width:700px;">
    <div class="modal-header">
      <h3 id="previewTitle">Anteprima bozza</h3>
      <button class="modal-close" id="btnClosePreview">&times;</button>
    </div>
    <div class="modal-body">
      <div id="previewContent" style="white-space:pre-wrap;font-size:14px;line-height:1.6;background:#f9fafb;padding:16px;border-radius:8px;max-height:500px;overflow-y:auto;"></div>
    </div>
  </div>
</div>

<!-- Sent Email Modal -->
<div id="sentEmailModal" class="modal-overlay" style="display:none;">
  <div class="modal" style="max-width:700px;">
    <div class="modal-header">
      <h3 id="sentEmailTitle">📨 Email inviata</h3>
      <button class="modal-close" id="btnCloseSentEmail">&times;</button>
    </div>
    <div class="modal-body">
      <div id="sentEmailMeta" style="font-size:12px;color:var(--text-secondary);margin-bottom:12px;"></div>
      <div id="sentEmailContent" style="white-space:pre-wrap;font-size:14px;line-height:1.6;background:var(--hover-bg);padding:16px;border-radius:8px;max-height:500px;overflow-y:auto;"></div>
    </div>
  </div>
</div>

<!-- Followup Preview Modal -->
<div id="followupModal" class="modal-overlay" style="display:none;">
  <div class="modal" style="max-width:700px;">
    <div class="modal-header">
      <h3 id="followupTitle">Followup — Dettaglio</h3>
      <button class="modal-close" id="btnCloseFollowup">&times;</button>
    </div>
    <div class="modal-body" id="followupBody">
      <div style="text-align:center;padding:30px;color:var(--text-secondary);">Caricamento...</div>
    </div>
  </div>
</div>

<!-- Schedule Date Picker Modal -->
<div id="scheduleModal" class="modal-overlay" style="display:none;">
  <div class="modal" style="max-width:460px;">
    <div class="modal-header">
      <h3 id="scheduleTitle">Pianifica invio</h3>
      <button class="modal-close" id="btnCloseSchedule">&times;</button>
    </div>
    <div class="modal-body">
      <p style="font-size:14px;color:var(--text-secondary);margin-bottom:16px;" id="scheduleDesc">Scegli la data per l'invio della prima email</p>
      <div id="scheduleModeToggle" style="display:none;gap:6px;margin-bottom:14px;">
        <button type="button" id="btnModeSingle" class="btn btn-sm schedule-mode-btn active" style="flex:1;">📅 Stessa data</button>
        <button type="button" id="btnModeSpread" class="btn btn-sm schedule-mode-btn" style="flex:1;">⏳ Spalma sul mese</button>
      </div>
      <div id="scheduleSingleFields">
        <input type="datetime-local" id="scheduleDatePicker" style="width:100%;padding:10px 14px;border:1px solid var(--border);border-radius:8px;font-size:14px;">
      </div>
      <div id="scheduleSpreadFields" style="display:none;">
        <div style="display:flex;gap:8px;margin-bottom:10px;">
          <div style="flex:1.4;">
            <label style="font-size:12px;font-weight:600;display:block;margin-bottom:4px;">📅 Data di partenza</label>
            <input type="date" id="spreadStartDate" style="width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:8px;font-size:14px;">
          </div>
          <div style="flex:0.7;">
            <label style="font-size:12px;font-weight:600;display:block;margin-bottom:4px;">🕘 Ora</label>
            <select id="spreadHour" style="width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:8px;font-size:14px;">
              <option value="8">08:00</option><option value="9" selected>09:00</option>
              <option value="10">10:00</option><option value="11">11:00</option>
              <option value="12">12:00</option><option value="13">13:00</option>
              <option value="14">14:00</option><option value="15">15:00</option>
              <option value="16">16:00</option><option value="17">17:00</option>
            </select>
          </div>
          <div style="flex:0.7;">
            <label style="font-size:12px;font-weight:600;display:block;margin-bottom:4px;">✉️ Email al giorno</label>
            <input type="number" id="spreadPerDay" min="1" max="500" value="10" style="width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:8px;font-size:14px;">
          </div>
        </div>
        <div id="spreadPreview" style="font-size:13px;padding:10px 12px;background:#eef2ff;border:1px solid #c7d2fe;border-radius:8px;color:#4338ca;min-height:38px;"></div>
      </div>
    </div>
    <div class="modal-footer" style="display:flex;justify-content:flex-end;gap:8px;">
      <button class="btn btn-secondary" id="btnCancelSchedule">Annulla</button>
      <button class="btn btn-secondary" id="btnClearSchedule">🗑️ Rimuovi data</button>
      <button class="btn btn-primary" id="btnSaveSchedule">Salva</button>
    </div>
  </div>
</div>

<!-- Edit Email Modal -->
<div id="editEmailModal" class="modal-overlay" style="display:none;">
  <div class="modal" style="max-width:420px;">
    <div class="modal-header">
      <h3 id="editEmailTitle">Cambia email</h3>
      <button class="modal-close" id="btnCloseEditEmail">&times;</button>
    </div>
    <div class="modal-body">
      <p style="font-size:14px;color:var(--text-secondary);margin-bottom:12px;" id="editEmailDesc">Inserisci il nuovo indirizzo email per <strong id="editEmailCompanyName"></strong></p>
      <input type="email" id="editEmailInput" placeholder="nuova@email.it" style="width:100%;padding:10px 14px;border:1px solid var(--border);border-radius:8px;font-size:14px;">
      <div id="editEmailFeedback" style="margin-top:8px;font-size:13px;display:none;"></div>
    </div>
    <div class="modal-footer" style="display:flex;justify-content:flex-end;gap:8px;">
      <button class="btn btn-secondary" id="btnCancelEditEmail">Annulla</button>
      <button class="btn btn-primary" id="btnSaveEditEmail">💾 Salva</button>
    </div>
  </div>
</div>

<style>
  .btn-success { background:#10b981;color:#fff; }
  .btn-success:hover { background:#059669; }
  .btn-danger { background:#ef4444;color:#fff; }
  .btn-danger:hover { background:#dc2626; }
  .btn-sm { font-size:12px;padding:4px 10px;border-radius:6px;border:1px solid var(--border);background:#fff;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:4px; }
  .btn-sm:hover { background:#f1f5f9; }

  .schedule-mode-btn { border:1px solid var(--border);background:#fff;color:var(--text-primary);padding:8px 10px;font-size:13px;border-radius:8px;cursor:pointer;transition:all 0.15s; }
  .schedule-mode-btn:hover { background:#f1f5f9; }
  .schedule-mode-btn.active { background:var(--brand-primary);color:#fff;border-color:var(--brand-primary); }
  
  .modal-overlay {
    position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);
    display:flex;align-items:center;justify-content:center;z-index:1000;
  }
  .modal { background:#fff;border-radius:12px;box-shadow:0 20px 25px -5px rgba(0,0,0,0.2);width:90%;max-height:80vh;display:flex;flex-direction:column; }
  .modal-header { display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid var(--border); }
  .modal-header h3 { margin:0;font-size:16px; }
  .modal-close { background:none;border:none;font-size:24px;cursor:pointer;color:var(--text-secondary);padding:0;line-height:1; }
  .modal-close:hover { color:var(--text-primary); }
  .modal-body { padding:16px 20px;overflow-y:auto;flex:1; }
  .modal-footer { padding:12px 20px;border-top:1px solid var(--border); }
  
  .badge { display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600; }
  .badge-pending { background:#fef3c7;color:#92400e; }
  .badge-draft { background:#dbeafe;color:#1e40af; }
  .badge-approved { background:#d1fae5;color:#065f46; }
  .badge-sent { background:#e0e7ff;color:#3730a3; }
  .badge-bounced { background:#fee2e2;color:#991b1b; }
  .badge-opened { background:#ede9fe;color:#5b21b6; }
  
  .action-btn { padding:4px 10px;border-radius:6px;border:1px solid var(--border);background:#fff;cursor:pointer;font-size:12px;transition:all 0.15s; }
  .action-btn:hover { background:#f1f5f9; }
  .action-btn-approve { border-color:#10b981;color:#065f46; }
  .action-btn-approve:hover { background:#d1fae5; }
  .action-btn-approve.active { background:#10b981;color:#fff; }
  .action-btn-approve.active:hover { background:#059669; }
  .action-btn-danger { border-color:#ef4444;color:#991b1b; }
  .action-btn-danger:hover { background:#fee2e2; }

  th.sortable { cursor:pointer;user-select:none;white-space:nowrap; }
  th.sortable:hover { background:#f1f5f9; }
  th.sortable .sort-icon { display:inline-block;width:16px;text-align:center;font-size:11px;color:var(--text-secondary);margin-left:4px; }
  th.sortable .sort-icon::after { content:'↕';opacity:0.3; }
  th.sortable.sort-asc .sort-icon::after { content:'↑';opacity:1;color:var(--brand-primary);font-weight:700; }
  th.sortable.sort-desc .sort-icon::after { content:'↓';opacity:1;color:var(--brand-primary);font-weight:700; }
  
  #workflowTable { table-layout:fixed;width:100%; }
  #workflowTable td { vertical-align:middle;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
  #workflowTable td:first-child { text-align:center;overflow:visible; }
  #workflowTable td:nth-child(2) { text-align:center; }
  #workflowTable td:nth-child(8) { text-align:center;overflow:visible; }
  #workflowTable td:nth-child(9) { text-align:center;overflow:visible; }
  #workflowTable td:nth-child(10) { white-space:nowrap;overflow:visible; }
  #workflowTable th { overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
  .subject-cell { max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer;color:var(--brand-primary); }
  .subject-cell:hover { text-decoration:underline; }
  
  .followup-badge { display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:600;cursor:pointer; }
  .followup-badge:hover { opacity:0.8; }
  .followup-pending { background:#fef3c7;color:#92400e; }
  .followup-sent { background:#e0e7ff;color:#3730a3; }
  .followup-none { background:#f1f5f9;color:#94a3b8; }
  
  .page-num { padding:4px 10px;border-radius:6px;border:1px solid var(--border);background:#fff;cursor:pointer;font-size:13px; }
  .page-num.active { background:var(--brand-primary);color:#fff;border-color:var(--brand-primary); }
  .page-num:hover:not(.active) { background:#f1f5f9; }
  
  .followup-step { padding:12px 16px;border:1px solid var(--border);border-radius:8px;margin-bottom:8px; }
  .followup-step.sent { border-left:3px solid var(--success); }
  .followup-step.pending { border-left:3px solid var(--warning); }
  .followup-step.cancelled { border-left:3px solid var(--danger);opacity:0.6; }
  .followup-step.not-scheduled { border-left:3px solid var(--border);opacity:0.5; }
</style>

<script>
const CAMPAIGN_ID = <%= campaign.id %>;
let companies = [];
let currentPage = 1, totalPages = 1, totalCount = 0;
let sortBy = "nome_studio", sortOrder = "asc";
let availableCompanies = [];
let isLoadingMore = false;
let scheduleTargetId = null;
let scheduleMode = 'single';

// ── URL sync ──
function loadSortFromURL() {
  const p = new URLSearchParams(window.location.search);
  if (p.has('sort')) sortBy = p.get('sort');
  if (p.has('order')) sortOrder = p.get('order') === 'asc' ? 'asc' : 'desc';
  if (p.has('filter')) document.getElementById('workflowFilter').value = p.get('filter');
  if (p.has('search')) document.getElementById('workflowSearch').value = p.get('search');
}
function pushSortURL() {
  const p = new URLSearchParams();
  if (sortBy !== 'nome_studio') p.set('sort', sortBy);
  if (sortOrder !== 'asc') p.set('order', sortOrder);
  const filter = document.getElementById('workflowFilter').value;
  const search = document.getElementById('workflowSearch').value;
  if (filter && filter !== 'all') p.set('filter', filter);
  if (search) p.set('search', search);
  const qs = p.toString();
  const url = qs ? window.location.pathname + '?' + qs : window.location.pathname;
  window.history.replaceState(null, '', url);
}
// Apply sort icon to active header
function applySortIndicator() {
  document.querySelectorAll('#workflowTable th.sortable').forEach(th => {
    th.classList.remove('sort-asc', 'sort-desc');
    const icon = th.querySelector('.sort-icon');
    if (th.dataset.sort === sortBy) {
      th.classList.add(sortOrder === 'asc' ? 'sort-asc' : 'sort-desc');
    } else {
      icon.textContent = '';
    }
  });
}
loadSortFromURL();
applySortIndicator();

async function loadCompanies(page, append) {
  if (page) currentPage = page;
  if (isLoadingMore) return;
  isLoadingMore = append || false;
  const filter = document.getElementById('workflowFilter').value;
  const search = document.getElementById('workflowSearch').value;
  try {
    const res = await fetch(`/api/campaigns/${CAMPAIGN_ID}/companies?page=${currentPage}&limit=50&filter=${encodeURIComponent(filter)}&search=${encodeURIComponent(search)}&sort_by=${sortBy}&sort_order=${sortOrder}`);
    const data = await res.json();
    totalPages = data.pages;
    totalCount = data.total;
    if (append) {
      companies = companies.concat(data.companies);
      document.getElementById('workflowTbody').insertAdjacentHTML('beforeend', renderCompaniesRows(data.companies, currentPage));
    } else {
      companies = data.companies;
      renderCompanies();
    }
    updateKpis(data.kpi);
    updateBatchButtons();
    document.getElementById('totalCompaniesCount').textContent = `${totalCount} aziende totali`;
    isLoadingMore = false;
    if (currentPage < totalPages) {
      observer.observe(document.getElementById('scrollSentinel'));
    }
  } catch (e) {
    isLoadingMore = false;
    if (!append) document.getElementById('workflowTbody').innerHTML = '<tr><td colspan="10" style="text-align:center;padding:40px;color:var(--danger);">Errore caricamento aziende</td></tr>';
  }
}

function renderCompanies() {
  if (companies.length === 0) {
    const filter = document.getElementById('workflowFilter').value;
    const search = document.getElementById('workflowSearch').value;
    let msg = 'Nessun azienda trovato';
    if (!search && filter === 'approved') msg = '🎉 Tutti i aziende approvati sono già pianificati! Vai su "📅 Pianificati" per vederli, oppure approva nuove bozze con "✓ Appr.".';
    else if (!search && filter === 'scheduled') msg = 'Nessun azienda pianificato in attesa di invio. Approva le bozze (✓ Appr.) e poi pianificali con "📅 Pian.".';
    document.getElementById('workflowTbody').innerHTML = `<tr><td colspan="10" style="text-align:center;padding:30px;color:var(--text-secondary);">${msg}</td></tr>`;
    return;
  }
  document.getElementById('workflowTbody').innerHTML = renderCompaniesRows(companies, 1);
}

function renderCompaniesRows(list, startNum) {
  let html = '';
  list.forEach((d, i) => {
    let badge = '', badgeClass = '';
    let blockIcon = '';
    if (d.failed_count > 0) { badge = '❌ Fallito'; badgeClass = 'badge-bounced'; }
    else if (d.email_bounced) { badge = '📧 Invalida'; badgeClass = 'badge-bounced'; }
    else if (d.email_opened_at) { badge = '👁️ Aperta'; badgeClass = 'badge-opened'; }
    else if (d.inviato) { badge = '📤 Inviato'; badgeClass = 'badge-sent'; }
    else if (d.approvato) { 
      badge = '✅ Approvato'; badgeClass = 'badge-approved';
      if (d.block_reasons && d.block_reasons.includes('cold_richiede_invio_manuale')) {
        blockIcon = ' <span style="color:#0ea5e9;cursor:help;font-size:11px;" title="Consenso cold: invio SOLO one-to-one manuale (mai in folle automatiche)">❄️</span>';
      } else if (d.block_reasons && d.block_reasons.includes('non_schedulato')) {
        blockIcon = ' <span style="color:#d97706;cursor:help;font-size:11px;" title="Approvato ma senza data di invio — clicca 📅 per pianificare">⚠️</span>';
      }
    }
    else if (d.bozza_creata) { badge = '📝 Bozza'; badgeClass = 'badge-draft'; }
    else if (d.bozza_failed_count > 0) { badge = '⚠️ Fallita'; badgeClass = 'badge-bounced'; }
    else { badge = '⏳ In attesa'; badgeClass = 'badge-pending'; }
    
    // Tooltip diagnostico
    let titleAttr = '';
    if (d.block_reasons && d.block_reasons.length > 0) {
      const labels = {
        'già_inviato': 'Email già inviata',
        'disiscritto': 'Azienda disiscritto',
        'email_mancante': 'Email mancante',
        'bozza_mancante': 'Bozza non generata',
        'non_approvato': 'Non approvato',
        'invio_fallito': '❌ Invio fallito (' + d.failed_count + ' tentativi)',
        'cold_richiede_invio_manuale': '❄️ Consenso cold: invio solo manuale one-to-one',
        'non_schedulato': 'Data invio non pianificata',
        'pronto': 'Pronto per l\'invio',
        'nessun_smtp': 'Nessun account SMTP attivo'
      };
      titleAttr = ' title="' + d.block_reasons.map(r => labels[r] || r).join(' · ') + '"';
      // Aggiungi ultimo errore nel tooltip se presente
      if (d.last_error) {
        titleAttr = titleAttr.slice(0, -1) + '\\nUltimo errore: ' + d.last_error.slice(0, 120) + '"';
      }
    }
    
    const name = [d.nome_studio, d.nome_azienda].filter(Boolean).join(' - ') || '—';
    const city = [d.comune, d.provincia].filter(Boolean).join(' (') + (d.provincia ? ')' : '') || '—';
    
    // Followup badge — detailed status indicators
    let followupHtml = '';
    const fuApproved = d.followup_approved || 0;
    const fuDraftPending = d.followup_draft_pending || 0;
    const fuPending = d.followup_pending || 0;
    const fuSent = d.followup_sent || 0;
    if (fuApproved > 0 || fuDraftPending > 0 || fuSent > 0 || fuPending > 0) {
      let parts = [];
      if (fuApproved > 0) parts.push(`<span style="color:#10b981;" title="Approvati">✅${fuApproved}</span>`);
      if (fuDraftPending > 0) parts.push(`<span style="color:#d97706;" title="Bozza pronta, in attesa approvazione">⏳${fuDraftPending}</span>`);
      if (fuSent > 0) parts.push(`<span style="color:#6366f1;" title="Inviati">📤${fuSent}</span>`);
      if (fuPending > 0 && fuDraftPending === 0) parts.push(`<span style="color:#94a3b8;" title="In attesa generazione">⏳${fuPending}</span>`);
      followupHtml = `<span class="followup-badge" data-id="${d.id}" data-action="showFollowups" title="Click per dettaglio followup" style="background:#f1f5f9;color:#475569;font-size:11px;display:inline-flex;gap:4px;">${parts.join(' ')}</span>`;
    } else {
      followupHtml = `<span class="followup-badge followup-none" data-id="${d.id}" data-action="showFollowups">—</span>`;
    }
    
    // Schedule cell
    let scheduleHtml = '<span style="color:var(--text-secondary);font-size:11px;">—</span>';
    if (d.send_scheduled_at) {
      const dt = new Date(d.send_scheduled_at);
      scheduleHtml = `<span style="font-size:11px;color:var(--brand-primary);cursor:pointer;" data-id="${d.id}" data-action="openScheduleDatePicker" title="Clicca per cambiare data">📅 ${dt.toLocaleDateString('it-IT', {day:'2-digit',month:'short'})} ${dt.toLocaleTimeString('it-IT', {hour:'2-digit',minute:'2-digit'})}</span>`;
    } else if (!d.inviato) {
      scheduleHtml = `<button class="action-btn" data-id="${d.id}" data-action="openScheduleDatePicker" title="Pianifica invio" style="font-size:11px;">📅</button>`;
    }
    
    // Schedulabile = non inviato, non già pianificato, non bloccato (cold/fallito)
    const schedulable = !d.inviato && !d.send_scheduled_at && !(d.block_reasons || []).some(r => ['cold_richiede_invio_manuale','invio_fallito'].includes(r));
    
    html += `<tr>
      <td><input type="checkbox" class="companyCheckbox" value="${d.id}" data-approved="${d.approvato}" data-draft="${d.bozza_creata}" data-sent="${d.inviato}" data-schedulable="${schedulable}"></td>
      <td style="color:var(--text-secondary);font-size:11px;">${(startNum-1)*50+i+1}</td>
      <td><strong style="font-size:13px;">${name}</strong></td>
      <td style="font-size:11px;">${d.email || '—'}${d.email ? `<span style="cursor:pointer;margin-left:4px;font-size:12px;color:var(--text-secondary);" data-id="${d.id}" data-action="editEmail" title="Cambia email">✏️</span>` : ''}${d.inviato && d.sent_email_subject ? `<span style="cursor:pointer;margin-left:4px;font-size:14px;color:#22c55e;" onclick="viewSentEmail(${d.id})" title="Vedi email inviata">📨</span>` : ''}</td>
      <td style="font-size:11px;">${city}</td>
      <td><span class="badge ${badgeClass}"${titleAttr}>${badge}${blockIcon}</span></td>
      <td>${d.bozza_email_oggetto ? `<span class="subject-cell" data-id="${d.id}" data-action="previewDraft" title="Clicca per vedere la bozza">${d.bozza_email_oggetto}</span>` : '<span style="color:var(--text-secondary);font-size:11px;">—</span>'}</td>
      <td style="text-align:center;">${followupHtml}</td>
      <td style="text-align:center;">${scheduleHtml}</td>
      <td style="white-space:nowrap;">${renderActions(d)}</td>
    </tr>`;
  });
  return html;
}

function renderActions(d) {
  let actions = '';
  if (d.bozza_creata && d.bozza_email) {
    actions += `<button class="action-btn" data-id="${d.id}" data-action="previewDraft" title="Anteprima bozza">👁️</button> `;
  }
  if (d.bozza_creata && !d.inviato) {
    const activeClass = d.approvato ? ' active' : '';
    const label = d.approvato ? '✓ Approvato' : '○ Approva';
    actions += `<button class="action-btn action-btn-approve${activeClass}" data-id="${d.id}" data-action="toggleApprove">${label}</button> `;
  }
  if (!d.inviato) {
    actions += `<button class="action-btn" data-id="${d.id}" data-action="regenerateDraft" title="Rigenera bozza">🔄</button> `;
  }
  if (d.bozza_failed_count > 2) {
    actions += `<button class="action-btn" data-id="${d.id}" data-action="resetFailedCount" title="Sblocca azienda (azzecca contatore fallimenti AI)" style="border-color:#f59e0b;color:#92400e;">🔓 Sblocca</button> `;
  }
  actions += `<button class="action-btn action-btn-danger" data-id="${d.id}" data-action="removeFromCampaign" title="Rimuovi">✕</button>`;
  return actions || '<span style="color:var(--text-secondary);font-size:11px;">—</span>';
}

function updateKpis(kpi) {
  if (!kpi) return;
  document.getElementById('kpiTotal').textContent = kpi.total;
  document.getElementById('kpiDraft').textContent = kpi.with_draft;
  document.getElementById('kpiApproved').textContent = kpi.approved;
  document.getElementById('kpiScheduled').textContent = kpi.scheduled || 0;
  document.getElementById('kpiSent').textContent = kpi.sent;
  document.getElementById('kpiOpened').textContent = kpi.opened;
  document.getElementById('kpiBounced').textContent = kpi.bounced;
  document.getElementById('kpiFailed').textContent = kpi.failed || 0;

  // Diagnostic alerts
  let alerts = '';
  if (kpi.failed > 0) {
    alerts += `<div class="alert alert-danger" style="padding:10px 16px;border-radius:8px;background:#fef2f2;border:1px solid #fecaca;color:#991b1b;font-size:13px;display:flex;align-items:center;gap:8px;margin-bottom:8px;">
      ❌ <strong>${kpi.failed} aziende</strong> con invio fallito. Passa il mouse sul badge <strong>"❌ Fallito"</strong> nella tabella per vedere l'errore. <a href="?filter=failed" style="color:#991b1b;font-weight:bold;">Vedi tutti →</a>
    </div>`;
  }
  if (kpi.approved_not_scheduled > 0) {
    alerts += `<div class="alert alert-warning" style="padding:10px 16px;border-radius:8px;background:#fef3c7;border:1px solid #f59e0b;color:#92400e;font-size:13px;display:flex;align-items:center;gap:8px;margin-bottom:8px;">
      ⚠️ <strong>${kpi.approved_not_scheduled} aziende approvati</strong> ma senza data di invio pianificata. 
      Usa il pulsante 📅 per impostare la data di partenza, oppure selezionali e usa <strong>"Pian."</strong> in blocco.
    </div>`;
  }
  if (kpi.approved_cold > 0) {
    alerts += `<div class="alert alert-info" style="padding:10px 16px;border-radius:8px;background:#e0f2fe;border:1px solid #7dd3fc;color:#0369a1;font-size:13px;display:flex;align-items:center;gap:8px;margin-bottom:8px;">
      ❄️ <strong>${kpi.approved_cold} aziende approvati</strong> con consenso <strong>cold</strong> (né marketing né opt-in verificato): non entrano nelle folle/schedulazione automatica. Vanno inviati <strong>solo manualmente one-to-one</strong> (flusso "Invio manuale" dal dettaglio azienda).
      <span style="font-size:11px;color:#0ea5e9;">(Vedi tooltip ❄️ nei badge)</span>
    </div>`;
  }
  if (kpi.smtp_available === false) {
    alerts += `<div class="alert alert-danger" style="padding:10px 16px;border-radius:8px;background:#fee2e2;border:1px solid #ef4444;color:#991b1b;font-size:13px;display:flex;align-items:center;gap:8px;margin-bottom:8px;">
      🚫 <strong>Nessun account SMTP attivo!</strong> Le email non possono essere inviate. 
      Vai su <a href="/admin/smtp-accounts" style="color:#991b1b;font-weight:bold;">Amministrazione → Account SMTP</a> per configurarne uno.
    </div>`;
  }
  document.getElementById('diagnosticAlerts').innerHTML = alerts;
}

// Infinite scroll via IntersectionObserver
const observer = new IntersectionObserver((entries) => {
  if (entries[0].isIntersecting && currentPage < totalPages && !isLoadingMore) {
    currentPage++;
    loadCompanies(null, true);
  }
}, { rootMargin: '400px' });

function toggleSelectAll() {
  const checked = document.getElementById('selectAllCompanies').checked;
  document.querySelectorAll('.companyCheckbox').forEach(cb => cb.checked = checked);
  updateBatchButtons();
  document.getElementById('selectN').value = '0';
}

function selectFirstN(n) {
  if (n <= 0) return;
  const checkboxes = Array.from(document.querySelectorAll('.companyCheckbox'));
  let selected = 0;
  checkboxes.forEach(cb => {
    const canSelect = cb.dataset.schedulable === 'true';
    cb.checked = canSelect && selected < n;
    if (cb.checked) selected++;
  });
  updateBatchButtons();
  document.getElementById('selectAllCompanies').checked = checkboxes.length > 0 && Array.from(checkboxes).every(cb => cb.checked);
  if (selected === 0) {
    showToast('❌ Nessun azienda pianificabile in questa lista (tutti già pianificati o bloccati)', 'error');
  } else if (selected < n) {
    showToast(`⚠️ Selezionati ${selected} aziende pianificabili — ${n - selected} saltati perché già pianificati o bloccati`, 'warning');
  }
}

async function removeAllNoEmail() {
  if (!confirm('🗑️ Rimuovere TUTTI i aziende senza email da questa campagna?')) return;
  try {
    const res = await fetch(`/api/campaigns/${CAMPAIGN_ID}/remove-noemail`, { method: 'POST' });
    const data = await res.json();
    if (data.removed > 0) {
      showToast(`🗑️ Rimossi ${data.removed} aziende senza email`, 'success');
      loadCompanies(1);
    } else {
      showToast('Nessun azienda senza email da rimuovere', 'info');
    }
  } catch (e) {
    showToast('❌ Errore rimozione', 'error');
  }
}

function updateBatchButtons() {
  const checked = document.querySelectorAll('.companyCheckbox:checked');
  const count = checked.length;
  document.getElementById('btnBatchApprove').disabled = count === 0;
  document.getElementById('btnBatchRegen').disabled = count === 0;
  document.getElementById('btnBatchSchedule').disabled = count === 0;
  document.getElementById('btnBatchRemove').disabled = count === 0;
  document.getElementById('btnBatchFollowupGenerate').disabled = count === 0;
  document.getElementById('btnBatchFollowupApprove').disabled = count === 0;
}

function getSelectedIds() {
  return Array.from(document.querySelectorAll('.companyCheckbox:checked')).map(cb => parseInt(cb.value));
}

async function batchAction(action) {
  const ids = getSelectedIds();
  if (ids.length === 0) { showToast('❌ Seleziona almeno un azienda', 'error'); return; }
  const labels = { approve: 'approvare', unapprove: 'revocare', regenerate: 'rigenerare', remove: 'rimuovere' };
  if (!confirm(`${labels[action] || action} ${ids.length} aziende selezionati?`)) return;
  try {
    const res = await fetch(`/api/campaigns/${CAMPAIGN_ID}/companies/batch`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, company_ids: ids })
    });
    const data = await res.json();
    if (!res.ok) { showToast('❌ ' + (data.error || 'Errore esecuzione'), 'error'); return; }
    if (data.updated === 0) { showToast('⚠️ Nessun azienda aggiornato', 'warning'); return; }
    showToast(`✅ ${data.updated} aziende ${action === 'remove' ? 'rimossi' : action === 'regenerate' ? 'in rigenerazione' : 'aggiornati'}`, 'success');
    document.getElementById('selectAllCompanies').checked = false;
    if (action === 'regenerate') {
      setTimeout(() => loadCompanies(), 4000);
    } else {
      await loadCompanies();
    }
  } catch (e) {
    showToast('❌ Errore azione batch: ' + e.message, 'error');
  }
}

// ── Batch Followup Actions ──
async function batchFollowupGenerate() {
  const ids = getSelectedIds();
  if (ids.length === 0) { showToast('❌ Seleziona almeno un azienda', 'error'); return; }
  if (!confirm(`Generare bozze followup per ${ids.length} aziende selezionati?`)) return;
  try {
    const res = await fetch(`/api/campaigns/${CAMPAIGN_ID}/generate-followup-drafts`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ company_ids: ids })
    });
    const data = await res.json();
    if (!res.ok || !data.success) { showToast('❌ ' + (data.error || 'Errore generazione followup'), 'error'); return; }
    showToast(`🔄 Generazione followup avviata per ${ids.length} aziende`, 'info');
    document.getElementById('selectAllCompanies').checked = false;
    setTimeout(() => loadCompanies(), 5000);
  } catch (e) { showToast('❌ Errore di rete: ' + e.message, 'error'); }
}

async function batchFollowupApprove() {
  const ids = getSelectedIds();
  if (ids.length === 0) { showToast('❌ Seleziona almeno un azienda', 'error'); return; }
  if (!confirm(`Approvare le bozze followup per ${ids.length} aziende selezionati?`)) return;
  try {
    const res = await fetch(`/api/campaigns/${CAMPAIGN_ID}/companies/batch-followup-approve`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ company_ids: ids, approvato: true })
    });
    const data = await res.json();
    if (!res.ok || data.error) { showToast('❌ ' + (data.error || 'Errore approvazione batch'), 'error'); return; }
    if (data.updated === 0) { showToast('⚠️ Nessun followup da approvare', 'warning'); return; }
    showToast(`✅ ${data.updated || 0} followup approvati`, 'success');
    document.getElementById('selectAllCompanies').checked = false;
    await loadCompanies();
  } catch (e) { showToast('❌ Errore di rete: ' + e.message, 'error'); }
}

// Sort by column
// ── Column sorting ──
document.querySelectorAll('#workflowTable th.sortable').forEach(th => {
  th.addEventListener('click', function() {
    const field = this.dataset.sort;
    if (sortBy === field) {
      sortOrder = sortOrder === 'asc' ? 'desc' : 'asc';
    } else {
      sortBy = field;
      sortOrder = 'asc';
    }
    applySortIndicator();
    pushSortURL();
    loadCompanies(1);
  });
});

// ── Preview Draft ──
async function previewDraft(companyId) {
  const d = companies.find(x => x.id === companyId);
  if (!d || !d.bozza_email) return;
  document.getElementById('previewTitle').textContent = `Bozza: ${d.bozza_email_oggetto || 'Senza oggetto'}`;
  document.getElementById('previewContent').textContent = d.bozza_email;
  document.getElementById('previewModal').style.display = 'flex';
}

// ── View Sent Email ──
async function viewSentEmail(companyId) {
  try {
    const res = await fetch(`/api/companies/${companyId}/sent-email`);
    if (!res.ok) { showToast('Email inviata non trovata', 'error'); return; }
    const data = await res.json();
    const d = data.company;
    document.getElementById('sentEmailTitle').textContent = `📨 Email inviata — ${d.nome_azienda || 'Azienda'}`;
    document.getElementById('sentEmailMeta').innerHTML = `
      <strong>Oggetto:</strong> ${escapeHtml(d.sent_email_subject)}<br>
      <strong>Destinatario:</strong> ${escapeHtml(d.email)}<br>
      <strong>Inviata il:</strong> ${d.inviato_at ? new Date(d.inviato_at).toLocaleString('it-IT') : '—'}
    `;
    document.getElementById('sentEmailContent').textContent = d.sent_email_body || '(nessun contenuto)';
    document.getElementById('sentEmailModal').style.display = 'flex';
  } catch (e) {
    showToast('Errore: ' + e.message, 'error');
  }
}

// ── Show Followups ──
async function showFollowups(companyId) {
  const d = companies.find(x => x.id === companyId);
  const name = [d?.nome_studio, d?.nome_azienda].filter(Boolean).join(' - ') || 'Azienda';
  document.getElementById('followupTitle').textContent = `Followup — ${name}`;
  document.getElementById('followupBody').innerHTML = '<div style="text-align:center;padding:30px;color:var(--text-secondary);">Caricamento...</div>';
  document.getElementById('followupModal').style.display = 'flex';
  
  try {
    const res = await fetch(`/api/campaigns/${CAMPAIGN_ID}/companies/${companyId}/followups`);
    const steps = await res.json();
    if (steps.length === 0) {
      document.getElementById('followupBody').innerHTML = '<div style="text-align:center;padding:30px;color:var(--text-secondary);">Nessun followup configurato per questa campagna.</div>';
      return;
    }
    let html = '';
    steps.forEach(s => {
      const statusClass = s.status === 'sent' ? 'sent' : s.status === 'pending' ? 'pending' : s.status === 'cancelled' ? 'cancelled' : 'not-scheduled';
      let statusLabel = '';
      if (s.sent_at) statusLabel = '✅ Inviato ' + new Date(s.sent_at).toLocaleDateString('it-IT');
      else if (s.cancelled_at) statusLabel = `❌ Cancellato (${s.cancel_reason || 'n/a'})`;
      else if (s.scheduled_at) statusLabel = `⏳ Programma: ${new Date(s.scheduled_at).toLocaleDateString('it-IT')}`;
      else statusLabel = '— Non programmato';

      html += `<div class="followup-step ${statusClass}" data-company-id="${companyId}" data-step-order="${s.step_order}">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
          <strong>Followup #${s.step_order}</strong>
          <span style="font-size:11px;color:var(--text-secondary);">Dopo ${s.delay_days} giorni — ${statusLabel}</span>
        </div>
        <div style="font-size:13px;font-weight:500;margin-bottom:4px;color:var(--text-secondary);">
          📋 Template: ${escapeHtml(s.template_subject || '(nessun oggetto)')}
        </div>
        <div style="font-size:12px;color:var(--text-secondary);white-space:pre-wrap;max-height:50px;overflow-y:auto;margin-bottom:8px;padding:6px 10px;background:#f8fafc;border-radius:6px;border:1px solid #e2e8f0;">
          ${s.template_body ? escapeHtml(s.template_body.substring(0, 200) + (s.template_body.length > 200 ? '...' : '')) : '(nessun template)'}
        </div>`;

      // Se c'è una bozza per-azienda, mostra il contenuto personalizzato
      if (s.draft_generato && s.draft_subject) {
        const approvedBadge = s.draft_approvato
          ? '<span style="color:#10b981;font-size:12px;">✅ Approvato</span>'
          : '<span style="color:#d97706;font-size:12px;">⏳ In attesa approvazione</span>';

        html += `
        <div class="draft-container" style="margin-top:8px;padding:8px 12px;background:#f0fdf4;border-radius:6px;border:1px solid #bbf7d0;">
          <div style="font-size:12px;font-weight:600;color:#166534;margin-bottom:4px;">📧 Bozza personalizzata:</div>
          <div class="draft-view" data-step="${s.step_order}">
            <div class="draft-subject-display" style="font-size:13px;font-weight:500;margin-bottom:4px;">${escapeHtml(s.draft_subject)}</div>
            <div class="draft-body-display" style="font-size:12px;color:var(--text-secondary);white-space:pre-wrap;max-height:100px;overflow-y:auto;padding:4px 0;">${escapeHtml(s.draft_body ? s.draft_body.substring(0, 300) + (s.draft_body.length > 300 ? '...' : '') : '(nessun contenuto)')}</div>
          </div>
          <div class="draft-edit" data-step="${s.step_order}" style="display:none;margin-bottom:8px;">
            <input type="text" class="draft-edit-subject" value="${escapeHtml(s.draft_subject)}" style="width:100%;padding:6px 10px;border:1px solid var(--border);border-radius:6px;font-size:13px;margin-bottom:6px;">
            <textarea class="draft-edit-body" rows="6" style="width:100%;padding:6px 10px;border:1px solid var(--border);border-radius:6px;font-size:13px;font-family:inherit;">${escapeHtml(s.draft_body || '')}</textarea>
          </div>
          <div style="margin-top:6px;">${approvedBadge}</div>
          <div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap;">
            <button class="action-btn action-btn-approve ${s.draft_approvato ? 'active' : ''}"
                    onclick="toggleFollowupDraftApprove(${d.id}, ${s.step_order}, ${!s.draft_approvato})"
                    style="font-size:11px;padding:3px 8px;">
              ${s.draft_approvato ? '✓ Revoca' : '○ Approva'}
            </button>
            <button class="action-btn" onclick="regenerateFollowupDraft(${d.id}, ${s.step_order})"
                    style="font-size:11px;padding:3px 8px;">🔄 Rigenera</button>
            <button class="action-btn draft-edit-btn" data-step="${s.step_order}" style="font-size:11px;padding:3px 8px;">✏️ Modifica</button>
            <button class="action-btn draft-save-btn" data-step="${s.step_order}" style="font-size:11px;padding:3px 8px;display:none;background:#10b981;color:#fff;border-color:#10b981;">💾 Salva</button>
            <button class="action-btn draft-cancel-btn" data-step="${s.step_order}" style="font-size:11px;padding:3px 8px;display:none;">❌ Annulla</button>
            <button class="action-btn" onclick="previewFollowupDraft(${d.id}, ${s.step_order})"
                    style="font-size:11px;padding:3px 8px;">👁️ Preview</button>
          </div>
        </div>`;
      } else if (s.sent_at) {
        // Step already sent — show sent content link
        html += `<div style="margin-top:8px;padding:8px 12px;background:#e0e7ff;border-radius:6px;border:1px solid #c7d2fe;">
          <div style="font-size:12px;color:#3730a3;margin-bottom:4px;">📨 Followup inviato</div>
          <button class="action-btn" onclick="viewSentFollowup(${d.id}, ${s.step_order})" style="font-size:11px;padding:3px 8px;">📨 Vedi inviato</button>
        </div>`;
      } else {
        html += `<div style="margin-top:6px;"><span style="color:#94a3b8;font-size:12px;">⏳ In attesa generazione</span></div>`;
      }

      html += `</div>`;
    });
    document.getElementById('followupBody').innerHTML = html;

    // One-time event delegation for inline edit/save/cancel buttons (prevent stacking)
    if (!document.getElementById('followupBody').dataset._editDelegation) {
      document.getElementById('followupBody').dataset._editDelegation = '1';
      document.getElementById('followupBody').addEventListener('click', async function(e) {
        const editBtn = e.target.closest('.draft-edit-btn');
        const saveBtn = e.target.closest('.draft-save-btn');
        const cancelBtn = e.target.closest('.draft-cancel-btn');
        if (editBtn) {
          const step = parseInt(editBtn.dataset.step);
          toggleDraftEdit(step, true);
        } else if (saveBtn) {
          const step = parseInt(saveBtn.dataset.step);
          const stepEl = e.target.closest('.followup-step');
          const did = parseInt(stepEl?.dataset.companyId);
          if (did) await saveDraftInline(did, step);
        } else if (cancelBtn) {
          const step = parseInt(cancelBtn.dataset.step);
          toggleDraftEdit(step, false);
        }
      });
    }
  } catch (e) {
    document.getElementById('followupBody').innerHTML = '<div style="text-align:center;padding:30px;color:var(--danger);">Errore caricamento followup</div>';
  }
}

// ── Toggle draft edit mode ──
function toggleDraftEdit(step, showEdit) {
  const container = document.querySelector(`.draft-container[data-step="${step}"]`);
  if (!container) return;
  const viewEl = container.querySelector(`.draft-view[data-step="${step}"]`);
  const editEl = container.querySelector(`.draft-edit[data-step="${step}"]`);
  const editBtn = container.querySelector(`.draft-edit-btn[data-step="${step}"]`);
  const saveBtn = container.querySelector(`.draft-save-btn[data-step="${step}"]`);
  const cancelBtn = container.querySelector(`.draft-cancel-btn[data-step="${step}"]`);
  if (!viewEl || !editEl) return;
  viewEl.style.display = showEdit ? 'none' : '';
  editEl.style.display = showEdit ? '' : 'none';
  if (editBtn) editBtn.style.display = showEdit ? 'none' : '';
  if (saveBtn) saveBtn.style.display = showEdit ? '' : 'none';
  if (cancelBtn) cancelBtn.style.display = showEdit ? '' : 'none';
}

// ── Save draft inline ──
async function saveDraftInline(companyId, stepOrder) {
  const container = document.querySelector(`.draft-container[data-step="${stepOrder}"]`);
  if (!container) return;
  const subject = container.querySelector('.draft-edit-subject').value;
  const body = container.querySelector('.draft-edit-body').value;
  try {
    const res = await fetch(`/api/campaigns/${CAMPAIGN_ID}/companies/${companyId}/followup-drafts/${stepOrder}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ subject, body })
    });
    const data = await res.json();
    if (!data.success) { showToast(data.error || 'Errore salvataggio', 'error'); return; }
    showToast(`Followup #${stepOrder} salvato`, 'success');
    showFollowups(companyId); // reload modal
  } catch (e) { showToast('Errore di rete', 'error'); }
}

