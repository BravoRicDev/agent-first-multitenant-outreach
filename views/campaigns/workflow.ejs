    e.target.style.display = 'none';
  }
});

// ── Event delegation: workflow table (dynamic rows) ──
document.getElementById('workflowTbody').addEventListener('click', function(e) {
  const target = e.target.closest('[data-action]');
  if (!target) return;
  const id = parseInt(target.dataset.id);
  switch (target.dataset.action) {
    case 'previewDraft': previewDraft(id); break;
    case 'showFollowups': showFollowups(id); break;
    case 'openScheduleDatePicker': openScheduleDatePicker(id); break;
    case 'editEmail': openEditEmail(id); break;
    case 'toggleApprove': toggleApprove(id); break;
    case 'regenerateDraft': regenerateDraft(id); break;
    case 'resetFailedCount': resetFailedCount(id); break;
    case 'removeFromCampaign': removeFromCampaign(id); break;
  }
});
