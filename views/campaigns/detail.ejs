<div class="page-header">
  <h1 id="pageTitle"><%= campaign ? 'Modifica campagna' : 'Nuova campagna' %></h1>
  <a href="/campaigns" class="btn btn-secondary">← Tutte le campagne</a>
</div>

<% if (campaign) { %>
<div class="kpi-grid" style="grid-template-columns:repeat(4,1fr);">
  <div class="kpi-card"><div class="kpi-value"><%= campaign.inviate || 0 %></div><div class="kpi-label">Email inviate</div></div>
  <div class="kpi-card"><div class="kpi-value"><%= campaign.aperte || 0 %></div><div class="kpi-label">Aperte</div></div>
  <div class="kpi-card"><div class="kpi-value"><%= campaign.cliccate || 0 %></div><div class="kpi-label">Cliccate</div></div>
  <div class="kpi-card"><div class="kpi-value"><%= campaign.bounced || 0 %></div><div class="kpi-label">Bounced</div></div>
</div>
<% } %>

<div class="card">
  <form id="campaignForm">
    <div class="form-group">
      <label>Nome campagna *</label>
      <input type="text" name="name" required value="<%= campaign?.name || '' %>" placeholder="Es. Campagna Aziende Roma – Maggio 2025">
    </div>

    <h3 style="margin:20px 0 12px;">Testo per generazione email</h3>
    <p style="font-size:13px;color:var(--text-secondary);margin-bottom:12px;">
      Questi campi vengono passati all'AI per generare le email di questa campagna. Lasciandoli vuoti si usano i valori globali da "Direzione".
    </p>

    <div class="form-group">
      <label>Info Azienda <small>(chi siete, cosa fate, perché vi differenziate)</small></label>
      <textarea name="info_azienda" rows="6" placeholder="⚠️ OBBLIGATORIO — Se lasci vuoto, l'AI userà i dati generici della Direzione e le bozze risulteranno scollegate dalla campagna.

Scrivi chi siete, cosa offrite, perché il prospect dovrebbe scegliervi. Es. «Siamo un'agenzia di marketing specializzata in...»"><%= campaign?.info_azienda || '' %></textarea>
    </div>
    <div class="form-group">
      <label>CTA <small>(cosa deve fare il prospect)</small></label>
      <input type="text" name="cta" value="<%= campaign?.cta || '' %>" placeholder="Es. Prenota una chiamata gratuita di 15 minuti">
    </div>
    <div class="form-group">
      <label>Link CTA</label>
      <input type="url" name="link_cta" value="<%= campaign?.link_cta || '' %>" placeholder="https://calendly.com/...">
    </div>
    <div class="form-group">
      <label>Email Spunti <small>(esempi di email che l'AI deve usare come riferimento principale)</small></label>
      <textarea name="email_spunti" rows="8" placeholder="⚠️ FONTE PRINCIPALE per l'AI — Incolla 2-3 email o bozze di esempio che hanno funzionato.
L'AI seguirà questi esempi per tono, argomento e struttura.

Se lasci vuoto, l'AI si baserà solo su Info Azienda e Template."><%= campaign?.email_spunti || '' %></textarea>
    </div>
    <div class="form-group">
      <label>Template Email <small>(struttura fissa che l'AI deve seguire)</small></label>
      <textarea name="email_template" rows="6" placeholder="⚠️ FACOLTATIVO — Se lasci vuoto, l'AI si baserà solo sugli Spunti.
Se lo compili, questo template guida la struttura dell'email.
Suggerimento: [APERTURA PERSONALIZZATA]
[PROBLEMA DEL SETTORE]
[SOLUZIONE CHE OFFRIAMO]
[CTA]"><%= campaign?.email_template || '' %></textarea>
    </div>

    <h3 style="margin:20px 0 12px;">Pipeline CMS agent-first</h3>
    <div class="form-group">
      <label>Pipeline <small>(opportunità create nel CRM del CMS su questa pipeline)</small></label>
      <select name="cms_pipeline_id" id="campaignPipelineSelect" style="flex:1;">
        <option value="">— Nessuna (opzionale) —</option>
        <% if (typeof cmsPipelines !== 'undefined' && cmsPipelines.length) { cmsPipelines.forEach(p => { %>
        <option value="<%= p.id %>" <%= String(campaign?.cms_pipeline_id) === String(p.id) ? 'selected' : '' %>><%= p.name %></option>
        <% }); } %>
      </select>
      <small style="display:block;margin-top:6px;color:var(--text-secondary);">La mappa stage è opzionale in fase 1: senza, l'opportunità viene creata nello stage di default della pipeline.</small>
    </div>

    <h3 style="margin:20px 0 12px;">Account SMTP</h3>
    <div class="form-group">
      <label>Account SMTP dedicato <small>(lascia vuoto per round-robin globale)</small></label>
      <div style="display:flex;gap:8px;align-items:center;">
        <select name="smtp_account_id" style="flex:1;padding:8px 12px;border:1px solid var(--border);border-radius:8px;">
          <option value="">— Round-robin globale —</option>
          <% if (typeof smtpAccounts !== 'undefined') { smtpAccounts.forEach(a => { %>
          <option value="<%= a.id %>" <%= String(campaign?.smtp_account_id) === String(a.id) ? 'selected' : '' %>><%= a.name %> (<%= a.from_email %>)</option>
          <% }); } %>
        </select>
        <button type="button" class="btn btn-sm btn-secondary js-test-smtp">🔌 Test</button>
        <span id="smtpTestResult" style="font-size:12px;"></span>
      </div>
    </div>

    <h3 style="margin:20px 0 12px;">Formato email</h3>
    <div class="form-group">
      <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
        <input type="checkbox" name="use_html" value="true" <%= campaign?.use_html ? 'checked' : '' %>>
        Invia in formato HTML
      </label>
    </div>
    <div class="form-group" id="htmlWrapperGroup" style="<%= campaign?.use_html ? '' : 'display:none;' %>">
      <label>HTML Wrapper <small>(usa <code>{{BODY}}</code> per il contenuto)</small></label>
      <textarea name="html_wrapper" rows="8" style="font-family:monospace;font-size:12px;width:100%;"><%= campaign?.html_wrapper || '' %></textarea>
      <button type="button" class="btn btn-sm btn-secondary js-preview-html">👁 Anteprima</button>
    </div>
    <div class="form-group">
      <label>Footer email (testo) <small>— usa <code>{{UNSUB_URL}}</code> per link disiscrizione</small></label>
      <textarea name="footer_text" rows="3" style="width:100%;" placeholder="Per non ricevere ulteriori comunicazioni: {{UNSUB_URL}}"><%= campaign?.footer_text || '' %></textarea>
    </div>

    <h3 style="margin:20px 0 12px;">Mittente email</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div class="form-group">
        <label>Nome mittente <small>(sovrascrive account SMTP)</small></label>
        <input type="text" name="from_name_override" value="<%= campaign?.from_name_override || '' %>" placeholder="Es. Mario Rossi">
      </div>
      <div class="form-group">
        <label>Email mittente <small>(sovrascrive account SMTP)</small></label>
        <input type="email" name="from_email_override" value="<%= campaign?.from_email_override || '' %>" placeholder="mario@esempio.com">
      </div>
    </div>
    <div class="form-group">
      <label>Reply-To <small>(a chi arrivano le risposte)</small></label>
      <input type="email" name="reply_to_email" value="<%= campaign?.reply_to_email || '' %>" placeholder="risposte@esempio.com">
    </div>
    <div class="form-group">
      <label>Limite giornaliero email <small>(0 = usa limite globale)</small></label>
      <input type="number" name="daily_email_limit" value="<%= campaign?.daily_email_limit || '' %>" placeholder="Es. 50">
    </div>
    <div style="font-size:12px;color:var(--text-secondary);padding:8px 12px;background:var(--bg-body);border-radius:8px;margin-bottom:12px;">
      <strong>Merge tags disponibili:</strong>
      <code>{{nome_azienda}}</code>
      <code>{{comune}}</code> <code>{{provincia}}</code> <code>{{cta_link}}</code>
    </div>

    <h3 style="margin:20px 0 12px;">Prompt AI personalizzati</h3>
    <p style="font-size:13px;color:var(--text-secondary);margin-bottom:12px;">
      Se vuoti, si usano i prompt globali dalle Impostazioni.
    </p>
    <div class="form-group">
      <label>Prompt Copywriter <small>(generazione email)</small></label>
      <textarea name="prompt_copywriter" rows="6" placeholder="Lascia vuoto per usare il prompt globale dalle Impostazioni."><%= campaign?.prompt_copywriter || '' %></textarea>
    </div>
    <div class="form-group">
      <label>Prompt Rewrite <small>(riscrittura email)</small></label>
      <textarea name="prompt_rewrite" rows="6" placeholder="Lascia vuoto per usare il prompt globale dalle Impostazioni."><%= campaign?.prompt_rewrite || '' %></textarea>
    </div>
    <div class="form-group">
      <label>Prompt Followup AI <small>(generazione followup — se vuoto si usa il prompt globale)</small></label>
      <textarea name="followup_prompt" rows="6" placeholder="Lascia vuoto per usare il prompt globale dalle Impostazioni."><%= campaign?.followup_prompt || '' %></textarea>
    </div>

    <div style="display:flex;gap:8px;margin-top:20px;align-items:center;">
      <button type="submit" class="btn btn-primary" id="saveBtn"><%= campaign ? 'Salva modifiche' : 'Crea campagna' %></button>
      <% if (campaign) { %>
      <a href="/companies?campaign_id=<%= campaign.id %>" class="btn btn-secondary">Aziende di questa campagna</a>
      <% } %>
      <span id="formMsg" style="font-size:13px;"></span>
    </div>
  </form>
</div>

<% if (campaign) { %>
<div class="card">
  <h3 style="margin-bottom:12px;">Invio email campagna</h3>
  <p style="font-size:13px;color:var(--text-secondary);margin-bottom:12px;">
    Invia le email a tutti i aziende approvati e non ancora inviati di questa campagna.
  </p>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <label style="font-size:13px;">Max:</label>
    <input type="number" id="batchLimit" value="50" min="1" max="500" style="width:80px;padding:6px 10px;border:1px solid var(--border);border-radius:8px;">
    <label style="font-size:13px;">Delay (sec):</label>
    <input type="number" id="batchDelay" value="30" min="5" max="300" style="width:80px;padding:6px 10px;border:1px solid var(--border);border-radius:8px;">
    <button class="btn btn-primary js-send-batch">▶ Avvia invio</button>
    <span id="batchMsg" style="font-size:13px;"></span>
  </div>
  <div id="batchProgress" style="display:none;margin-top:12px;padding:12px;background:var(--bg-body);border-radius:8px;">
    <div style="font-size:13px;" id="batchProgressText">In coda...</div>
  </div>
</div>

<div class="card">
  <h3 style="margin-bottom:12px;">Attività recente</h3>
  <div id="campaignAudit"><p style="color:var(--text-secondary);">Caricamento...</p></div>
</div>
<div class="card">
  <h3 style="margin-bottom:12px;">Test email</h3>
  <p style="font-size:13px;color:var(--text-secondary);margin-bottom:12px;">
    Invia una email di test per verificare firma, template HTML e footer prima di lanciare la campagna.
  </p>
  <div style="display:flex;gap:8px;align-items:center;">
    <input type="email" id="testEmailAddr" value="" placeholder="tua@email.com" style="flex:1;padding:8px 12px;border:1px solid var(--border);border-radius:8px;">
    <button class="btn btn-sm btn-secondary js-send-test">📨 Invia test</button>
    <span id="testEmailMsg" style="font-size:13px;"></span>
  </div>
</div>

<div class="card" id="campaignChecklist">
  <h3 style="margin-bottom:12px;">✅ Checklist pre-lancio</h3>
  <div id="checklistContent"><p style="color:var(--text-secondary);">Caricamento...</p></div>
</div>

<div class="card">
  <h3 style="margin-bottom:12px;">Sequenze Follow-up</h3>
  <p style="font-size:13px;color:var(--text-secondary);margin-bottom:12px;">
    Ogni step viene inviato automaticamente dopo il numero di giorni indicato.
    Se il destinatario risponde, tutti i followup successivi vengono cancellati.
  </p>
  <div id="campaignFollowupSequences"></div>
  <button type="button" class="btn btn-sm btn-secondary js-add-followup">+ Aggiungi step</button>
</div>
<% } %>

<script>
var campaignId = <%- JSON.stringify(campaign?.id || null) %>;
const cmsPipelineSelect = document.getElementById('campaignPipelineSelect');
cmsPipelineSelect.addEventListener('change', function() {
  // cms_pipeline_id viene inviato automaticamente dal name del select; nessuna
  // logica stage in fase 1 (l'opportunità CMS usa lo stage di default della pipeline).
});

document.getElementById('campaignForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  var btn = document.getElementById('saveBtn');
  btn.disabled = true; btn.textContent = 'Salvataggio...';
  var data = Object.fromEntries(new FormData(e.target));
  try {
    var url = campaignId ? '/api/campaigns/' + campaignId : '/api/campaigns';
    var method = campaignId ? 'PUT' : 'POST';
    var res = await fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
    var result = await res.json();
    if (result.success || result.id) {
      showToast(campaignId ? 'Campagna aggiornata' : 'Campagna creata');
      if (!campaignId && result.id) { setTimeout(function() { window.location.href = '/campaigns/' + result.id; }, 800); }
    } else { showToast('Errore: ' + (result.error || 'sconosciuto'), 'error'); }
  } catch(err) { showToast('Errore di connessione', 'error'); }
  btn.disabled = false; btn.textContent = campaignId ? 'Salva modifiche' : 'Crea campagna';
});

async function sendCampaignBatch() {
  var limit = parseInt(document.getElementById('batchLimit').value) || 50;
  var delay = parseInt(document.getElementById('batchDelay').value) || 30;
  var msg = document.getElementById('batchMsg');
  document.getElementById('batchProgress').style.display = 'block';
  msg.textContent = '⏳ Avvio...';
  try {
    var res = await fetch('/api/campaigns/' + campaignId + '/send-batch', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ limit: limit, delay_seconds: delay })
    });
    var data = await res.json();
    if (data.queued !== undefined) {
      msg.textContent = '✅ ' + data.queued + ' email accodate';
      showToast(data.queued + ' email accodate per l\'invio');
    } else { msg.textContent = '❌ ' + (data.error || 'Errore'); }
  } catch(e) { msg.textContent = '❌ Errore connessione'; }
}

async function loadCampaignAudit() {
  if (!campaignId) return;
  try {
    var res = await fetch('/api/campaigns/' + campaignId + '/activity');
    var data = await res.json();
    if (!data.length) {
      document.getElementById('campaignAudit').innerHTML = '<p style="color:var(--text-secondary);">Nessuna attività.</p>';
      return;
    }
    var html = '<table><thead><tr><th>Data</th><th>Utente</th><th>Azione</th></tr></thead><tbody>';
    data.forEach(function(a) {
      html += '<tr><td>' + new Date(a.created_at).toLocaleString('it-IT') + '</td><td>' + escapeHtml(a.user_name || '—') + '</td><td>' + escapeHtml(typeof a.details === 'string' ? a.details : (a.details || '—')) + '</td></tr>';
    });
    html += '</tbody></table>';
    document.getElementById('campaignAudit').innerHTML = html;
  } catch(e) {}
}

loadCampaignAudit();

document.querySelector('[name="use_html"]')?.addEventListener('change', function() {
  var group = document.getElementById('htmlWrapperGroup');
  if (group) group.style.display = this.checked ? '' : 'none';
});

function previewHtmlWrapper() {
  var wrapper = document.querySelector('[name="html_wrapper"]')?.value || '<div>{{BODY}}</div>';
  var sample = wrapper.replace('{{BODY}}', 'Caro Dottor Rossi,<br><br>La contatto per presentarle i nostri servizi...<br><br>Cordiali saluti');
  var w = window.open('', '_blank');
  w.document.write(sample || '<p>Nessun wrapper</p>');
  w.document.close();
}

async function sendTestEmail() {
  var addr = document.getElementById('testEmailAddr').value;
  if (!addr) { showToast('Inserisci un indirizzo email', 'error'); return; }
  var msg = document.getElementById('testEmailMsg');
  msg.textContent = '⏳ Invio...';
  try {
    var res = await fetch('/api/campaigns/' + campaignId + '/test-email', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ to: addr })
    });
    var data = await res.json();
    msg.textContent = data.success ? '✅ Inviata!' : '❌ ' + (data.error || 'Errore');
  } catch(e) { msg.textContent = '❌ Errore connessione'; }
}

async function loadChecklist() {
  if (!campaignId) return;
  try {
    var res = await fetch('/api/campaigns/' + campaignId + '/checklist');
    var data = await res.json();
    var html = '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px;">';
    data.forEach(function(item) {
      var ok = item.ok;
      html += '<div style="padding:10px 14px;border-radius:8px;background:' + (ok ? '#d1fae5' : '#fef3c7') + ';border:1px solid ' + (ok ? '#a7f3d0' : '#f59e0b') + ';">' +
        '<span style="font-size:16px;">' + (ok ? '✅' : '⚠️') + '</span> ' +
        '<strong style="font-size:13px;">' + escapeHtml(item.label) + '</strong>' +
        (item.detail ? '<br><small style="color:#666;">' + escapeHtml(item.detail) + '</small>' : '') +
        '</div>';
    });
    html += '</div>';
    document.getElementById('checklistContent').innerHTML = html;
  } catch(e) { document.getElementById('checklistContent').innerHTML = '<p style="color:var(--text-secondary);">Errore</p>'; }
}

async function testCampaignSmtp() {
  var accountId = document.querySelector('[name="smtp_account_id"]').value;
  if (!accountId) { showToast('Seleziona prima un account SMTP', 'error'); return; }
  document.getElementById('smtpTestResult').textContent = '⏳';
  try {
    var res = await fetch('/api/admin/smtp-accounts/' + accountId + '/test', { method: 'POST' });
    var data = await res.json();
    document.getElementById('smtpTestResult').textContent = data.success ? '✅ OK' : '❌ ' + (data.error || 'Errore');
  } catch(e) { document.getElementById('smtpTestResult').textContent = '❌ Errore'; }
}

var campaignFollowups = [];

async function loadCampaignFollowups() {
  if (!campaignId) return;
  try {
    var res = await fetch('/api/followup-sequences?campaign_id=' + campaignId);
    campaignFollowups = await res.json();
    renderCampaignFollowups();
  } catch(e) { document.getElementById('campaignFollowupSequences').innerHTML = '<p style="color:var(--danger);">Errore caricamento</p>'; }
}

function renderCampaignFollowups() {
  var container = document.getElementById('campaignFollowupSequences');
  if (!container) return;
  if (!campaignFollowups.length) { container.innerHTML = '<p style="color:var(--text-secondary);">Nessuna sequenza configurata.</p>'; return; }
  var html = '';
  campaignFollowups.forEach(function(seq, i) {
    html += '<div class="seq-step" data-id="' + seq.id + '" data-index="' + i + '" style="border:1px solid var(--border);border-radius:8px;padding:12px;margin-bottom:12px;background:var(--bg-body);">' +
      '<div style="display:flex;gap:8px;align-items:start;flex-wrap:wrap;">' +
      '<div class="filter-group" style="min-width:30px;"><label>#</label>' +
        '<div style="display:flex;flex-direction:column;gap:2px;margin-top:4px;">' +
          '<button type="button" class="btn btn-sm js-fu-up" data-index="' + i + '" ' + (i === 0 ? 'disabled style="opacity:0.4;"' : '') + ' style="padding:0 6px;font-size:10px;line-height:1.2;">▲</button>' +
          '<button type="button" class="btn btn-sm js-fu-down" data-index="' + i + '" ' + (i === campaignFollowups.length - 1 ? 'disabled style="opacity:0.4;"' : '') + ' style="padding:0 6px;font-size:10px;line-height:1.2;">▼</button>' +
        '</div>' +
      '</div>' +
      '<div class="filter-group" style="min-width:70px;"><label>Step</label><input type="number" class="seq-order" value="' + seq.step_order + '" min="1" style="width:70px;"></div>' +
      '<div class="filter-group" style="min-width:90px;"><label>Giorni</label><input type="number" class="seq-delay" value="' + seq.delay_days + '" min="1" style="width:90px;"></div>' +
      '<div class="filter-group" style="min-width:50px;"><label>Attivo</label><input type="checkbox" class="seq-active" ' + (seq.is_active ? 'checked' : '') + ' style="margin-top:8px;"></div>' +
      '<button type="button" class="btn btn-sm btn-danger js-delete-followup" data-id="' + seq.id + '" data-index="' + i + '" style="margin-top:20px;">🗑</button>' +
      '</div>' +
      '<div class="form-group" style="margin-top:8px;"><label>Oggetto</label><input type="text" class="seq-subject" value="' + escapeHtml(seq.subject || '') + '" style="width:100%;"></div>' +
      '<div class="form-group"><label>Corpo</label><textarea class="seq-body" rows="5" style="width:100%;">' + escapeHtml(seq.body || '') + '</textarea></div>' +
      '<button type="button" class="btn btn-sm btn-secondary js-save-followup" data-index="' + i + '" data-id="' + seq.id + '">💾 Salva</button>' +
      '</div>';
  });
  container.innerHTML = html;
}

function addCampaignFollowupStep() {
  var order = campaignFollowups.length > 0 ? Math.max.apply(null, campaignFollowups.map(function(s) { return s.step_order; })) + 1 : 1;
  campaignFollowups.push({ id: null, step_order: order, delay_days: 4, subject: '', body: '', is_active: true, campaign_id: campaignId });
  renderCampaignFollowups();
}

async function saveCampaignFollowupStep(index, id) {
  var el = document.querySelectorAll('.seq-step')[index];
  if (!el) return;
  var data = {
    step_order: parseInt(el.querySelector('.seq-order').value) || index + 1,
    delay_days: parseInt(el.querySelector('.seq-delay').value) || 4,
    subject: el.querySelector('.seq-subject').value,
    body: el.querySelector('.seq-body').value,
    is_active: el.querySelector('.seq-active').checked,
    campaign_id: campaignId,
  };
  var url = id ? '/api/followup-sequences/' + id : '/api/followup-sequences';
  var method = id ? 'PUT' : 'POST';
  var res = await fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
  var result = await res.json();
  if (result.success || result.sequence) { showToast('Step salvato'); loadCampaignFollowups(); }
  else showToast('Errore: ' + (result.error || 'sconosciuto'), 'error');
}

async function deleteCampaignFollowup(id, index) {
  if (id) { try { await fetch('/api/followup-sequences/' + id, { method: 'DELETE' }); } catch(e) {} }
  campaignFollowups.splice(index, 1);
  renderCampaignFollowups();
}

// ── Reorder followup steps (up/down) ──
function moveFollowupStep(index, direction) {
  var newIndex = index + direction;
  if (newIndex < 0 || newIndex >= campaignFollowups.length) return;
  // Swap
  var tmp = campaignFollowups[index];
  campaignFollowups[index] = campaignFollowups[newIndex];
  campaignFollowups[newIndex] = tmp;
  // Re-assign step_order values
  campaignFollowups.forEach(function(seq, i) {
    seq.step_order = i + 1;
  });
  renderCampaignFollowups();
  // Auto-save all changed sequences
  campaignFollowups.forEach(function(seq, i) {
    if (seq.id) {
      saveCampaignFollowupStep(i, seq.id);
    }
  });
}

loadCampaignFollowups();
loadChecklist();

// Helper: escape HTML
function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// --- Inline event handlers converted to addEventListener ---
// (handler GHL rimossi in fase 2: pipeline caricata dal server via cmsPipelines)
document.querySelector('.js-test-smtp')?.addEventListener('click', testCampaignSmtp);
document.querySelector('.js-preview-html')?.addEventListener('click', previewHtmlWrapper);
document.querySelector('.js-send-batch')?.addEventListener('click', sendCampaignBatch);
document.querySelector('.js-send-test')?.addEventListener('click', sendTestEmail);
document.querySelector('.js-add-followup')?.addEventListener('click', addCampaignFollowupStep);
// Event delegation for dynamically-generated followup buttons
document.getElementById('campaignFollowupSequences')?.addEventListener('click', function(e) {
  var btn = e.target.closest('.js-delete-followup');
  if (btn) {
    var rawId = btn.getAttribute('data-id');
    var id = rawId === 'null' ? null : rawId;
    var index = parseInt(btn.getAttribute('data-index'));
    deleteCampaignFollowup(id, index);
    return;
  }
  btn = e.target.closest('.js-save-followup');
  if (btn) {
    var rawId = btn.getAttribute('data-id');
    var id = rawId === 'null' ? null : rawId;
    var index = parseInt(btn.getAttribute('data-index'));
    saveCampaignFollowupStep(index, id);
    return;
  }
  btn = e.target.closest('.js-fu-up');
  if (btn) {
    var index = parseInt(btn.getAttribute('data-index'));
    moveFollowupStep(index, -1);
    return;
  }
  btn = e.target.closest('.js-fu-down');
  if (btn) {
    var index = parseInt(btn.getAttribute('data-index'));
    moveFollowupStep(index, 1);
  }
});
</script>
