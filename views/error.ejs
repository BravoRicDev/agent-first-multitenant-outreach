<div style="text-align: center; padding: 80px 20px;">
  <h2 style="margin-bottom: 16px;"><%= t('error.title') %></h2>
  <p style="color: var(--text-secondary); margin-bottom: 24px;"><%= messageKey ? t(messageKey) : (typeof message !== 'undefined' ? message : t('error.message')) %></p>
  <a href="/dashboard" class="btn btn-primary"><%= t('error.back') %></a>
</div>
